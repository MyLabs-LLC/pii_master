# Stage 2 training artifacts (models, ONNX exports, downloaded datasets)
training/artifacts/
*.parquet

# Built model packages. The BINARIES are build output and do not belong in git
# (44 MB each, and git stores every version forever). Their MANIFEST.json and
# MODEL_CARD.md are copied into models/ and committed, so the provenance --
# checksums, source commit, measured scores, limitations -- is in version
# control even though the weights are distributed separately.
dist/

# Build outputs of the model pipeline: weights and hashed feature caches are
# reproducible from training/ and run to gigabytes. dist/ is already ignored above.
projects/*/models/
projects/*/cache/
projects/*/artifacts/
projects/*/mlflow.db
mlruns/
projects/*/mlruns/
projects/*/data/
**/predictions.jsonl
# Model binaries wherever they are staged (see projects/*/models/ above).
**/weights.npz
**/*.safetensors
# Assembled run records and command archives run to tens of MB on large sweeps.
# run.json is regenerable from the project's evaluations/.
projects/pii-priority-recall-v1/run.json
projects/pii-priority-recall-v1/reports/*.commands.txt
